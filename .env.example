# ============================================================
# FLOWIX PAYLINK - KONFIGURASI PRODUKSI / TUTORIAL
# ============================================================
# Fokus .env hanya untuk konfigurasi penting:
# - Kredensial API Flowix
# - Username dan password admin
# - Minimal nominal invoice
# - Email VAPID untuk web-push admin
# - URL webhook publik untuk callback Flowix
#
# Sistem otomatis:
# - APP_URL/domain untuk UI tetap dibaca dari request host + protocol.
# - Secret session admin stabil dibuat dari backend config, jadi browser ditutup tetap login.
# - VAPID public/private key dibuat otomatis backend dan disimpan privat di data/vapid-keys.json.
# - Metode pembayaran diambil dinamis dari Flowix API dan dicache ke data/cache/deposit-methods.json.
# - Fee by customer default backend = true, tetap bisa dipilih admin per invoice.
# - Pending sync jalan tiap 8 detik, expired sweep tiap 15 detik, dan langsung jalan saat startup.
# - URL webhook Flowix otomatis didaftarkan ke endpoint /profile saat server startup.
# ============================================================

# ============================================================
# 1) KREDENSIAL API FLOWIX
# ============================================================
FLOWIX_BASE_URL=https://flowix.web.id/api/v1
FLOWIX_API_KEY=sk_live_replace_with_your_flowix_api_key
FLOWIX_MERCHANT_ID=MID-REPLACE_WITH_YOUR_MERCHANT_ID
FLOWIX_WEBHOOK_SECRET=whsec_replace_with_your_flowix_webhook_secret
FLOWIX_WEBHOOK_CALLBACK_URL=https://your-domain.com/webhooks/flowix
AUTO_REGISTER_FLOWIX_WEBHOOK=true

# ============================================================
# 2) AKUN ADMIN PAYLINK
# ============================================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-strong-admin-password
ADMIN_SESSION_MAX_AGE_DAYS=30

# ============================================================
# 3) DEFAULT PAYLINK / INVOICE
# ============================================================
MIN_INVOICE_AMOUNT=100

# ============================================================
# 4) WEB PUSH ADMIN
# ============================================================
# Isi email aktif. Backend otomatis generate VAPID public/private key.
VAPID_SUBJECT_EMAIL=admin@example.com
